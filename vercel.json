{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "application-server": {
      "root": "application-server",
      "framework": "express",
      "entrypoint": "src/app.js"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "application-server" }
    },
    {
      "source": "/health",
      "destination": { "service": "application-server" }
    },
    {
      "source": "/assets/(.*)",
      "destination": { "service": "frontend", "path": "/assets/$1" }
    },
    {
      "source": "/favicon.svg",
      "destination": { "service": "frontend", "path": "/favicon.svg" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend", "path": "/index.html" }
    }
  ]
}
