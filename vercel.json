{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "application-server": {
      "root": "application-server",
      "framework": "express",
      "entrypoint": "src/app.js"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "functions": {
    "application-server/src/app.js": {
      "includeFiles": "application-server/src/seed-data.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "application-server" }
    },
    {
      "source": "/health",
      "destination": { "service": "application-server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
