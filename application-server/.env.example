# Application Server Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/retail_financial_db

# Alternative individual DB connection parameters (if DATABASE_URL is not used)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail_financial_db
DB_USER=postgres
DB_PASSWORD=postgres

# Secret Key for JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_2026

# Server 2 AI/ML Microservice Private URL
ML_SERVER_URL=http://localhost:8000

# AWS Cloud Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=ai-retail-financial-planning-artifacts
